    {
      "name": "browser-receive-v1.mjs",
      "sha256": "c8da49c27c1e85e8408450ec1f3bfe9a65252296f89145e7febc1e6a0c14498d",
      "assertions": [
        "assert.equal(sha(await readFile(report.path)),report.sha256)",
        "assert.deepEqual(observed,JSON.parse(JSON.stringify({...report.preview,provenance:report.identity})))",
        "assert.equal(await page.$eval('script:not([type=\"application/json\"]),img,iframe,link,form,input,button,a[href]',els=>els.length),0)",
        "assert.equal(rows.length,fields.preview.expenses.length)",
        "assert.equal(rows[i].category,notation(e.category)?JSON.stringify(e.category):e.category,'category '+i)",
        "assert.equal(rows[i].categoryNotation,notation(e.category)?'JSON string notation':null)",
        "assert.equal(rows[i].note,notation(e.note)?JSON.stringify(e.note):e.note,'note '+i)",
        "assert.equal(rows[i].noteNotation,notation(e.note)?'JSON string notation':null)",
        "assert.equal(rows[i].absent,null)",
        "assert.equal(rows[i].note,undefined)",
        "assert.equal(rows[i].absent,'No note supplied')",
        "assert.equal(await page.$('[data-peer-literal]'),null)",
        "assert(!inspection.includes('PRIOR-PRIVATE-NOTE'))",
        "assert(width.body<=width.viewport+1,JSON.stringify({id,width}))",
        "assert.deepEqual(totals,['29','100 → 129','1900 → 1871'])",
        "assert.deepEqual(cats.find(x=>x.category===' food ').values,['0','20','0','20','No budget in snapshot'])",
        "assert.deepEqual(cats.find(x=>x.category==='unbudgeted').values,['0','0','7','7','No budget in snapshot'])",
        "assert.deepEqual(cats.find(x=>x.category==='budget-only').values,['0','0','0','0','1 budget row'])",
        "assert.deepEqual(budgets,[['food','100','80','20','Within limit','101','-1','Over limit'],['zero','0','0','0','Within limit','1','-1','Over limit'],['budget-only','0','0','0','Within limit','0','0','Within limit']])",
        "assert.deepEqual(rows,[['1','Legacy unassigned; qualified by recorded currency context','Within limit','Over limit'],['2','Legacy unassigned; qualified by recorded currency context','Within limit','Within limit']])",
        "assert.deepEqual(totals,['0','0 → 0','0 → 0'])",
        "assert.equal(await page.$('#category-comparison'),null)",
        "assert.equal(await page.$('#budget-comparison'),null)",
        "assert.equal(await page.$('#planned-expenses'),null)",
        "assert((await page.$eval('main',e=>e.textContent)).includes('No applicable budget rows. No zero limit is inferred.'))",
        "assert.deepEqual(totals,['9007199254740991','0 → 9007199254740991','0 → -9007199254740991'])",
        "assert(scroll.every(x=>x.full<=x.width||['auto','scroll'].includes(x.overflow)))",
        "assert.deepEqual(result.pageErrors,[])",
        "assert.deepEqual(result.storageWrites,[])",
        "assert(result.requests.every(u=>u.startsWith('file:')),'No external or active resource requests')"
      ]
    },
