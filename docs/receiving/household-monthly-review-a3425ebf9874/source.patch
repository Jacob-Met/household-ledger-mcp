+  } catch (error) { report.source_error = String(error); report.status = "FAIL"; process.exitCode = 1; }
+  report.completed_at = new Date().toISOString();
+  report.passed_groups = report.checks.filter(c => c.status === "PASS").length;
+  report.failed_groups = report.checks.filter(c => c.status === "FAIL").length;
+  const bytes = Buffer.from(JSON.stringify(report, null, 2) + "\n");
+  try {
+    await writeFile(join(output, "browser-receipt.json"), bytes, { flag: "wx" });
+    console.log(JSON.stringify({ status: report.status, passed_groups: report.passed_groups, failed_groups: report.failed_groups,
+      assertions: report.assertions, screenshots: report.screenshots.length, files: report.saved_files.length,
+      receipt: join(output, "browser-receipt.json"), sha256: hash(bytes), source_unchanged: report.source_unchanged, cleanup: report.cleanup }));
+  } catch (error) { console.error("Unable to save receiving receipt:", error); process.exitCode = 1; }
+}
