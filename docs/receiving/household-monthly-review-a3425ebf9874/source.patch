+/**
+ * A detached, explicit-currency monthly review of one exact ledger byte snapshot.
+ * Domain validation and arithmetic remain owned by ledger.ts.
+ */
+import { createHash } from "node:crypto";
+import { TextDecoder } from "node:util";
+import { monthlySummary, validateLedgerData, validateMonth, type MonthlySummary } from "./ledger.js";
+
+export const MAX_REVIEW_INPUT_BYTES = 8 * 1024 * 1024;
+export const MAX_REVIEW_OUTPUT_BYTES = 8 * 1024 * 1024;
+
+export interface MonthlyReviewOptions {
+  month: string;
+  currency: string;
+  sourceLabel?: string;
+  generatedAt?: string;
+}
+
+export interface MonthlyReview {
+  html: string;
+  month: string;
+  currency: string;
+  generatedAt: string;
+  source: { label: string; bytes: number; sha256: string; ledgerVersion: number };
+  selectedTransactions: number;
+  summary: MonthlySummary;
+}
+
+function requireLabel(value: string, field: string): string {
+  if (typeof value !== "string") throw new Error(field + " must be text");
+  for (let i = 0; i < value.length; i++) {
+    const code = value.charCodeAt(i);
+    if (code === 0) throw new Error(field + " contains a NUL character that HTML cannot preserve");
+    if (code >= 0xd800 && code <= 0xdbff) {
+      const next = value.charCodeAt(++i);
+      if (!(next >= 0xdc00 && next <= 0xdfff)) {
+        throw new Error(field + " contains an unpaired Unicode surrogate");
+      }
+    } else if (code >= 0xdc00 && code <= 0xdfff) {
+      throw new Error(field + " contains an unpaired Unicode surrogate");
+    }
+  }
+  return value;
+}
+
+/** Numeric references keep CR/LF labels exact across HTML newline parsing. */
+function escapeHtml(value: string): string {
+  return value.replace(/[&<>"'\r\n\t]/g, char => ({
+    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
+    "\r": "&#13;", "\n": "&#10;", "\t": "&#9;",
+  })[char]!);
+}
+
+function label(value: string): string {
+  return '<bdi class="label">' + escapeHtml(value) + "</bdi>";
+}
+
+/** No decimal scale, conversion, or floating-point currency formatter is used. */
+function amount(value: number): string {
+  if (!Number.isSafeInteger(value)) throw new Error("review amount exceeds the safe integer range");
+  return String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+}
+
+function order(a: string, b: string): number {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+const styles = String.raw`:root { color-scheme: light; font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: #20312d; background: #f2f5f0; }
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 280px; }
+main { width: min(70rem, calc(100% - 2rem)); margin: 2.5rem auto; }
+header { margin-bottom: 1.5rem; }
+h1 { font-size: clamp(1.8rem, 4vw, 2.7rem); line-height: 1.15; margin: .25rem 0 .7rem; }
+h2 { font-size: 1.25rem; margin: 0 0 .75rem; }
+p { margin: .6rem 0; }
+.kicker { color: #255f4c; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; font-size: .8rem; }
+.selection { display: flex; flex-wrap: wrap; gap: .65rem; margin: 1rem 0; }
+.badge { padding: .3rem .6rem; border: 1px solid #9ab5a8; border-radius: .4rem; background: #e5efe8; font-weight: 700; }
+.subtitle, .muted { color: #52665d; }
+.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin: 1.2rem 0; }
+.card { min-width: 0; padding: 1.2rem; background: #fff; border: 1px solid #c7d5ca; border-radius: .75rem; }
+.card h2 { color: #52665d; font-size: .85rem; margin: 0; }
+.value { font: 750 clamp(1.4rem, 3vw, 2rem)/1.35 ui-monospace, SFMono-Regular, Consolas, monospace; margin: .45rem 0 .25rem; overflow-wrap: anywhere; }
+.unit { color: #52665d; font-size: .8rem; }
+section { min-width: 0; padding: 1.25rem; margin: 1rem 0; background: #fff; border: 1px solid #c7d5ca; border-radius: .75rem; }
+.table-scroll { max-width: 100%; overflow-x: auto; padding: .25rem; }
+.table-scroll:focus-visible { outline: 3px solid #a34d00; outline-offset: 2px; }
+table { width: 100%; border-collapse: collapse; }
+caption { text-align: left; color: #52665d; font-size: .88rem; padding-bottom: .8rem; }
+th, td { padding: .7rem .65rem; border-bottom: 1px solid #d9e1da; vertical-align: top; text-align: left; }
+thead th { color: #41564a; background: #f0f5ee; font-size: .85rem; }
+th[scope="row"] { font-weight: 650; max-width: 25rem; min-width: 9rem; overflow-wrap: anywhere; }
+bdi.label { white-space: pre-wrap; overflow-wrap: anywhere; }
+.number { text-align: right; font-variant-numeric: tabular-nums; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; white-space: nowrap; }
+.status { min-width: 9rem; font-weight: 650; }
+.over { color: #923a24; }
+.within { color: #255f4c; }
+.legacy { display: block; color: #7a561c; font-size: .8rem; font-weight: 500; margin-top: .3rem; }
+.empty { padding: .9rem; border: 1px dashed #a8bbad; border-radius: .4rem; background: #f6f8f3; }
+.provenance { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .4rem 1rem; font-size: .9rem; }
