+.provenance dd { margin: 0; overflow-wrap: anywhere; }
+.hash { font: .82rem/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; word-break: break-all; }
+footer { margin-top: 1.3rem; font-size: .88rem; color: #52665d; }
+@media (max-width: 560px) {
+ main { width: calc(100% - 1.25rem); margin: 1.4rem auto; }
+ .cards { grid-template-columns: minmax(0, 1fr); gap: .6rem; }
+ .card { padding: 1rem; }
+ section { padding: 1rem; }
+ .provenance { grid-template-columns: minmax(0, 1fr); gap: .15rem; }
+ .provenance dd { margin-bottom: .6rem; }
+}
+@media print {
+ :root, body { background: #fff; color: #111; font-size: 10pt; }
+ main { width: 100%; margin: 0; }
+ h1 { font-size: 23pt; }
+ .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
+ .card, section { border-radius: 0; box-shadow: none; }
+ .card { break-inside: avoid; }
+ section { padding: .8rem 0; border: 0; }
+ .table-scroll { overflow: visible; padding: 0; }
+ table { width: 100%; font-size: 8pt; }
+ th, td { padding: .35rem .3rem; }
+ th[scope="row"] { min-width: 0; max-width: 12rem; }
+ .status { min-width: 0; }
+ .number { white-space: normal; overflow-wrap: anywhere; }
+ thead { display: table-header-group; }
+ tr { break-inside: avoid; }
+ .provenance { grid-template-columns: max-content minmax(0, 1fr); }
+ .screen-only { display: none; }
+}`;
+
+/**
+ * Reads no filesystem or environment state and retains no reference to input.
+ * A source hash identifies captured bytes, not freshness or authenticity.
+ */
+export function createMonthlyReview(input: Uint8Array, options: MonthlyReviewOptions): MonthlyReview {
+  if (!(input instanceof Uint8Array)) throw new Error("ledger snapshot must be bytes");
+  if (input.byteLength === 0 || input.byteLength > MAX_REVIEW_INPUT_BYTES) {
+    throw new Error("ledger snapshot must contain 1.." + MAX_REVIEW_INPUT_BYTES + " bytes");
+  }
+  if (!options || typeof options !== "object") throw new Error("month and currency are required");
+  const month = validateMonth(options.month);
+  if (typeof options.currency !== "string" || !/^[A-Za-z]{3}$/.test(options.currency.trim())) {
+    throw new Error("currency must be an explicit 3-letter code");
+  }
+  const currency = options.currency.trim().toUpperCase();
+  const sourceLabel = requireLabel(options.sourceLabel ?? "ledger snapshot", "source label");
+  if (sourceLabel.trim().length === 0 || [...sourceLabel].length > 180) {
+    throw new Error("source label must contain 1..180 characters");
+  }
+  const generatedAt = options.generatedAt ?? new Date().toISOString();
+  if (typeof generatedAt !== "string" || !/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/.test(generatedAt) ||
+      !Number.isFinite(Date.parse(generatedAt)) || new Date(generatedAt).toISOString() !== generatedAt) {
+    throw new Error("generatedAt must be an exact UTC ISO timestamp");
+  }
+  const bytes = Buffer.from(input);
+  let raw: unknown;
+  try {
+    // Preserve a leading BOM, matching the native JSON reader's refusal.
+    raw = JSON.parse(new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(bytes));
+  } catch {
+    throw new Error("ledger snapshot must be valid UTF-8 JSON without a byte-order mark");
+  }
+  const data = validateLedgerData(raw);
+  const [year, monthNumber] = month.split("-").map(Number);
+  const summary = monthlySummary(data, year, monthNumber, currency);
+  const selectedTransactions = data.transactions.filter(t =>
+    t.date.startsWith(month) && t.currency.trim().toUpperCase() === currency).length;
+  const categories = Object.entries(summary.byCategory).sort(([a], [b]) => order(a, b));
+  for (const [category] of categories) requireLabel(category, "selected category");
+  const budgets = [...summary.budgets].sort((a, b) => order(a.category, b.category));
+  for (const budget of budgets) requireLabel(budget.category, "selected budget category");
+  const source = {
+    label: sourceLabel,
+    bytes: bytes.byteLength,
+    sha256: createHash("sha256").update(bytes).digest("hex"),
+    ledgerVersion: data.version,
+  };
+
+  const parts: string[] = [];
+  let outputBytes = 0;
+  const append = (part: string) => {
+    outputBytes += Buffer.byteLength(part, "utf8");
+    if (outputBytes > MAX_REVIEW_OUTPUT_BYTES) {
+      throw new Error("complete monthly review exceeds the " + MAX_REVIEW_OUTPUT_BYTES + "-byte output limit");
+    }
+    parts.push(part);
+  };
+  const moneyCell = (value: number) => '<td class="number">' + amount(value) + "</td>";
+
+  append("<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n");
+  append('<meta name="viewport" content="width=device-width, initial-scale=1">\n');
+  append('<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; style-src \'unsafe-inline\'; base-uri \'none\'; form-action \'none\'">\n');
+  append("<title>Household monthly review · " + month + " · " + currency + "</title>\n");
+  append("<style>\n" + styles + "\n</style>\n</head>\n<body>\n");
+  append('<main data-month="' + month + '" data-currency="' + currency + '">\n<header>\n');
+  append('<p class="kicker">Household Ledger · local snapshot</p>\n<h1>Monthly category &amp; budget review</h1>\n');
+  append('<p class="subtitle">An explicit month and currency, evaluated from the captured ledger bytes.</p>\n');
+  append('<div class="selection"><span class="badge" id="selected-month">' + month +
+    '</span><span class="badge" id="selected-currency">' + currency + "</span></div>\n");
+  append('<p><strong id="selected-count">' + selectedTransactions + "</strong> selected transactions. " +
+    "Amounts are exact integer <strong>minor units</strong>; no decimal scale or currency conversion is assumed.</p>\n</header>\n");
+  append('<div class="cards" aria-label="Selected monthly totals">\n');
+  for (const [id, title, value] of [
+    ["income", "Income recorded", summary.incomeMinor],
+    ["expense", "Expenses recorded", summary.expenseMinor],
+    ["net", "Income minus expenses", summary.netMinor],
+  ] as const) {
+    append('<article class="card"><h2>' + title + '</h2><p class="value" id="summary-' + id + '">' +
+      amount(value) + '</p><p class="unit">' + currency + " minor units</p></article>\n");
+  }
+  append("</div>\n<section aria-labelledby=\"category-heading\">\n<h2 id=\"category-heading\">By category</h2>\n");
+  if (categories.length === 0) {
+    append('<p class="empty" id="empty-categories">No recorded transactions match this month and currency. Zero recorded totals do not establish that activity is complete.</p>\n');
+  } else {
+    append('<div class="table-scroll" tabindex="0" role="region" aria-label="Category totals; scroll horizontally if needed"><table>\n');
+    append("<caption>Recorded income and expenses, separately. Category labels retain their exact spelling.</caption>\n");
+    append('<thead><tr><th scope="col">Category</th><th scope="col" class="number">Income · minor units</th><th scope="col" class="number">Expenses · minor units</th></tr></thead>\n<tbody id="category-body">\n');
+    for (const [category, totals] of categories) {
+      append('<tr><th scope="row">' + label(category) + "</th>" +
+        moneyCell(totals.incomeMinor) + moneyCell(totals.expenseMinor) + "</tr>\n");
+    }
+    append("</tbody></table></div>\n");
+  }
+  append("</section>\n<section aria-labelledby=\"budget-heading\">\n<h2 id=\"budget-heading\">Category budgets</h2>\n");
+  append("<p>Spending uses recorded expenses only; category income does not reduce it. A negative remaining amount is over the stored limit.</p>\n");
+  if (budgets.length === 0) {
+    append('<p class="empty" id="empty-budgets">No category budgets match this month and currency. No limit has been inferred.</p>\n');
+  } else {
+    append('<div class="table-scroll" tabindex="0" role="region" aria-label="Budget comparison; scroll horizontally if needed"><table>\n');
+    append("<caption>Stored limits compared with the selected monthly expenses, all in integer minor units.</caption>\n");
+    append('<thead><tr><th scope="col">Category</th><th scope="col" class="number">Limit</th><th scope="col" class="number">Spent</th><th scope="col" class="number">Remaining</th><th scope="col">Evaluation</th></tr></thead>\n<tbody id="budget-body">\n');
+    for (const budget of budgets) {
+      const status = budget.over ? "Over limit" : budget.limitMinor === 0 ? "Zero limit; no expenses" : "Within stored limit";
+      append('<tr><th scope="row">' + label(budget.category) +
+        (budget.currency === undefined ? '<span class="legacy">Currency unassigned · legacy single-currency context</span>' : "") +
+        "</th>" + moneyCell(budget.limitMinor) + moneyCell(budget.spentMinor) + moneyCell(budget.remainingMinor) +
+        '<td class="status ' + (budget.over ? "over" : "within") + '">' + status + "</td></tr>\n");
+    }
+    append("</tbody></table></div>\n");
+  }
+  append("</section>\n<section aria-labelledby=\"snapshot-heading\">\n<h2 id=\"snapshot-heading\">Snapshot &amp; evaluation</h2>\n");
+  append('<dl class="provenance"><dt>Source label</dt><dd id="source-label">' + label(source.label) + "</dd>\n");
+  append('<dt>Captured bytes</dt><dd id="source-bytes">' + source.bytes + "</dd>\n");
+  append('<dt>Source SHA-256</dt><dd class="hash" id="source-sha256">' + source.sha256 + "</dd>\n");
+  append('<dt>Ledger format version</dt><dd>' + source.ledgerVersion + "</dd>\n");
+  append('<dt>Report generated (UTC)</dt><dd><time id="generated-at" datetime="' + generatedAt + '">' + generatedAt + "</time></dd>\n");
+  append("<dt>Evaluation</dt><dd>Native ledger validation and monthlySummary rules; explicit month and currency.</dd></dl>\n");
+  append("<p>This static report reflects only the captured bytes. It does not refresh. Source freshness, completeness, and authenticity are unknown; the hash identifies bytes without certifying them. The generation time is not a transaction update time.</p>\n");
+  append("<p>The net figure is recorded income minus expenses for this selection, not an account balance or a cash-flow forecast. Other months and currencies are excluded. No conversion, recommendations, or limit assignment is performed.</p>\n");
+  append("<p>Transaction IDs, notes, and idempotency keys are omitted. Category and source labels, totals, and budget limits are present: keep this file private.</p>\n</section>\n");
+  append('<footer><p class="screen-only">Open this saved file offline. Use your browser’s Print command for a paper or PDF copy.</p><p>No scripts, external assets, network requests, or browser storage are required.</p></footer>\n');
+  append("</main>\n</body>\n</html>\n");
+
+  return { html: parts.join(""), month, currency, generatedAt, source, selectedTransactions, summary };
+}
diff --git a/test/monthly-review-cli.test.ts b/test/monthly-review-cli.test.ts
new file mode 100644
index 0000000..cab508b
--- /dev/null
+++ b/test/monthly-review-cli.test.ts
@@ -0,0 +1,155 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, writeFile, readFile, stat, lstat, readdir, mkdir, link, symlink, rm, truncate } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawn, spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { MAX_REVIEW_INPUT_BYTES } from "../src/monthly-review.js";
+
+const cli = fileURLToPath(new URL("../src/household-review.js", import.meta.url));
+const sample = JSON.stringify({
+  version: 2,
+  transactions: [{
+    id: "PRIVATE-IDENTITY", type: "expense", amountMinor: 123, currency: "USD", date: "2026-04-01",
+    category: "Food", note: "PRIVATE-NOTE", idempotencyKey: "PRIVATE-KEY", createdAt: "2026-04-01T00:00:00.000Z",
+  }],
+  budgets: [{ category: "Food", month: "2026-04", currency: "USD", limitMinor: 120 }],
+}, null, 2) + "\n";
+const args = (input: string, output: string) => [cli, "--ledger", input, "--month", "2026-04", "--currency", "USD", "--output", output];
+function run(argv: string[], timeout = 5000) {
+  return spawnSync(process.execPath, argv, { encoding: "utf8", timeout, env: { ...process.env, LEDGER_FILE: "/must-not-be-used" } });
+}
+async function within(body: (root: string, input: string) => Promise<void>) {
+  const root = await mkdtemp(join(tmpdir(), "household-review-test-"));
+  const input = join(root, "fictional-ledger.json");
+  await writeFile(input, sample, { mode: 0o600 });
+  try { await body(root, input); } finally { await rm(root, { recursive: true, force: true }); }
+}
+async function noTemps(root: string) {
+  assert.deepEqual((await readdir(root)).filter(p => p.startsWith(".household-review-")), []);
+}
+function refused(result: ReturnType<typeof run>) {
+  assert.equal(result.status, 1, result.stderr);
+  assert.equal(result.stdout, "");
+  assert.match(result.stderr, /^household-review: [^\r\n]+\n$/);
+  assert.ok(!result.stderr.includes("\n    at "));
+}
+
+test("actual compiled CLI publishes one private, complete source-bound HTML file", async () => within(async (root, input) => {
+  const destination = join(root, "monthly.html"), before = await stat(input);
+  const result = run(args(input, destination));
+  assert.equal(result.status, 0, result.stderr);
+  assert.equal(result.stderr, "");
+  const receipt = JSON.parse(result.stdout), output = await readFile(destination);
+  assert.equal(receipt.month, "2026-04");
+  assert.equal(receipt.currency, "USD");
+  assert.equal(receipt.selectedTransactions, 1);
+  assert.equal(receipt.sourceSha256, createHash("sha256").update(sample).digest("hex"));
+  assert.equal(receipt.reportSha256, createHash("sha256").update(output).digest("hex"));
+  assert.equal(receipt.reportBytes, output.length);
+  assert.ok(output.toString("utf8").endsWith("</html>\n"));
+  assert.match(output.toString("utf8"), /<td class="number">-3<\/td>/);
+  for (const value of ["PRIVATE-IDENTITY", "PRIVATE-NOTE", "PRIVATE-KEY", input]) {
+    assert.ok(!output.toString("utf8").includes(value), value);
+  }
+  if (process.platform !== "win32") assert.equal((await stat(destination)).mode & 0o777, 0o600);
+  assert.equal(await readFile(input, "utf8"), sample);
+  const after = await stat(input);
+  assert.equal(after.ino, before.ino); assert.equal(after.mtimeMs, before.mtimeMs);
+  await noTemps(root);
+}));
+
+test("existing destination, input alias, hardlink and symlink are preserved", async () => within(async (root, input) => {
+  const destination = join(root, "already.html"), hard = join(root, "hard.html"), symbolic = join(root, "symbolic.html");
+  await writeFile(destination, "EXISTING-REPORT-SENTINEL");
+  await link(input, hard);
+  await symlink(input, symbolic);
+  for (const output of [destination, input, hard, symbolic]) refused(run(args(input, output)));
+  assert.equal(await readFile(destination, "utf8"), "EXISTING-REPORT-SENTINEL");
+  assert.equal(await readFile(input, "utf8"), sample);
+  assert.equal((await stat(hard)).ino, (await stat(input)).ino);
+  assert.equal((await lstat(symbolic)).isSymbolicLink(), true);
+  await noTemps(root);
+}));
+
+test("a dangling output symlink and an existing directory are refused without replacement", async () => within(async (root, input) => {
+  const symbolic = join(root, "dangling.html"), directory = join(root, "directory");
+  await symlink(join(root, "absent-target"), symbolic); await mkdir(directory);
+  refused(run(args(input, symbolic))); refused(run(args(input, directory)));
+  assert.equal((await lstat(symbolic)).isSymbolicLink(), true);
+  assert.equal((await stat(directory)).isDirectory(), true);
+  await assert.rejects(stat(join(root, "absent-target")), { code: "ENOENT" });
+  await noTemps(root);
+}));
+
+test("missing, malformed and oversized inputs leave no report or temporary files", async () => within(async (root, input) => {
+  const destination = join(root, "refused.html");
+  refused(run(args(join(root, "absent.json"), destination)));
+  await writeFile(input, "{\"version\":");
+  refused(run(args(input, destination)));
+  await truncate(input, MAX_REVIEW_INPUT_BYTES + 1);
+  refused(run(args(input, destination)));
+  await assert.rejects(stat(destination), { code: "ENOENT" });
+  await noTemps(root);
+}));
+
+test("directories and POSIX FIFOs are rejected promptly rather than read indefinitely", async () => within(async (root) => {
+  const destination = join(root, "refused.html");
+  refused(run(args(root, destination)));
+  if (process.platform !== "win32") {
+    const fifo = join(root, "pipe.json");
+    const mkfifo = spawnSync("mkfifo", [fifo], { encoding: "utf8" });
+    assert.equal(mkfifo.status, 0, mkfifo.stderr);
+    const result = run(args(fifo, destination), 2000);
+    assert.equal(result.error, undefined);
+    refused(result);
+    assert.match(result.stderr, /regular file/);
+  }
+  await noTemps(root);
+}));
+
+test("argument and domain refusals do not create outputs or consult a default ledger", async () => within(async (root, input) => {
+  const destination = join(root, "refused.html"), complete = args(input, destination);
+  const cases = [
+    [cli], [cli, "--help", "--month", "2026-04"], [...complete, "--currency", "USD"],
+    [cli, "--ledger", input, "--month", "2026-04", "--currency", "", "--output", destination],
+    [cli, "--ledger", input, "--month", "2026-04", "--currency", "USD", "--ledger", destination],
+    [cli, "--ledger", input, "--month", "2026-13", "--currency", "USD", "--output", destination],
+    [cli, "--ledger", input, "--month", "2026-04", "--currency", "US", "--output", destination],
+  ];
+  for (const argv of cases) refused(run(argv));
+  const help = run([cli, "--help"]); assert.equal(help.status, 0); assert.match(help.stdout, /NEW_HTML_FILE/);
+  await assert.rejects(stat(destination), { code: "ENOENT" });
+  assert.equal(await readFile(input, "utf8"), sample);
+  await noTemps(root);
+}));
+
+test("a nonexistent output parent is not created and leaves the source unchanged", async () => within(async (root, input) => {
+  refused(run(args(input, join(root, "new-parent", "monthly.html"))));
+  await assert.rejects(stat(join(root, "new-parent")), { code: "ENOENT" });
+  assert.equal(await readFile(input, "utf8"), sample);
+  await noTemps(root);
+}));
+
+test("concurrent real CLI publishers admit exactly one complete output", async () => within(async (root, input) => {
+  const destination = join(root, "race.html");
+  const results = await Promise.all(Array.from({ length: 6 }, () => new Promise<{ code: number | null; stdout: string; stderr: string }>((resolve, reject) => {
+    const child = spawn(process.execPath, args(input, destination), { stdio: ["ignore", "pipe", "pipe"] });
+    let stdout = "", stderr = "";
+    child.stdout.setEncoding("utf8"); child.stderr.setEncoding("utf8");
+    child.stdout.on("data", data => { stdout += data; }); child.stderr.on("data", data => { stderr += data; });
+    child.on("error", reject); child.on("close", code => resolve({ code, stdout, stderr }));
+  })));
+  const successes = results.filter(result => result.code === 0);
+  assert.equal(successes.length, 1);
+  for (const result of results.filter(result => result.code !== 0)) {
+    assert.equal(result.code, 1); assert.match(result.stderr, /output .*exists|output appeared/);
+  }
+  const bytes = await readFile(destination);
+  assert.equal(JSON.parse(successes[0].stdout).reportSha256, createHash("sha256").update(bytes).digest("hex"));
+  assert.ok(bytes.toString("utf8").endsWith("</html>\n"));
+  assert.equal(await readFile(input, "utf8"), sample);
+  await noTemps(root);
+}));
diff --git a/test/monthly-review.test.ts b/test/monthly-review.test.ts
new file mode 100644
index 0000000..170f738
--- /dev/null
+++ b/test/monthly-review.test.ts
@@ -0,0 +1,186 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { createMonthlyReview, MAX_REVIEW_INPUT_BYTES, MAX_REVIEW_OUTPUT_BYTES } from "../src/monthly-review.js";
+import { type LedgerData, type Transaction } from "../src/ledger.js";
+
+const fixed = { month: "2026-04", currency: "USD", generatedAt: "2026-10-08T17:00:00.000Z" };
+const encode = (value: unknown) => Buffer.from(JSON.stringify(value) + "\n");
+const hash = (value: Uint8Array) => createHash("sha256").update(value).digest("hex");
+const transaction = (id: string, amountMinor: number, category: string, extra: Partial<Transaction> = {}): Transaction => ({
+  id, amountMinor, category, type: "expense", currency: "USD", date: "2026-04-12", createdAt: "2026-04-12T12:00:00.000Z", ...extra,
+});
+const empty = (): LedgerData => ({ version: 2, transactions: [], budgets: [] });
+function rowText(html: string, body: string): string[] {
+  const table = html.match(new RegExp('<tbody id="' + body + '">([\\s\\S]*?)</tbody>'))?.[1] ?? "";
+  return [...table.matchAll(/<tr>([\s\S]*?)<\/tr>/g)].map(match => match[1]);
+}
+
+test("one explicit selection preserves native gross arithmetic and omits transaction-private fields", () => {
+  const data = empty();
+  data.transactions.push(
+    transaction("PRIVATE-ID", 10000, "Salary", { type: "income", note: "PRIVATE-NOTE", idempotencyKey: "PRIVATE-KEY" }),
+    transaction("refund", 300, "Food", { type: "income" }),
+    transaction("spent", 2100, "Food", { currency: " usd " }),
+    transaction("euro", 999999, "OTHER-CURRENCY", { currency: "EUR" }),
+    transaction("later", 888888, "OTHER-MONTH", { date: "2026-05-01" }),
+  );
+  data.budgets.push(
+    { category: "Food", month: "2026-04", limitMinor: 2000, currency: "USD" },
+    { category: "Food", month: "2026-04", limitMinor: 100, currency: "EUR" },
+  );
+  const input = encode(data), before = Buffer.from(input);
+  const report = createMonthlyReview(input, { ...fixed, currency: " usd ", sourceLabel: "fictional.json" });
+  assert.deepEqual(input, before);
+  assert.equal(report.currency, "USD");
+  assert.equal(report.selectedTransactions, 3);
+  assert.deepEqual([report.summary.incomeMinor, report.summary.expenseMinor, report.summary.netMinor], [10300, 2100, 8200]);
+  assert.equal(report.summary.budgets[0].remainingMinor, -100);
+  assert.equal(report.summary.budgets[0].spentMinor, 2100, "income does not offset budget spending");
+  assert.equal(report.source.sha256, hash(before));
+  assert.equal(report.source.bytes, before.length);
+  assert.match(report.html, /id="summary-income">10,300</);
+  assert.match(report.html, /id="summary-expense">2,100</);
+  assert.match(report.html, /id="summary-net">8,200</);
+  assert.match(report.html, /Over limit/);
+  for (const privateText of ["PRIVATE-ID", "PRIVATE-NOTE", "PRIVATE-KEY", "OTHER-CURRENCY", "OTHER-MONTH"]) {
+    assert.ok(!report.html.includes(privateText), privateText);
+  }
+  input.fill(0);
+  assert.equal(report.source.sha256, hash(before));
+  assert.match(report.html, /fictional.json/);
+});
+
+test("zero and budget-only selections stay explicit without inventing activity or limits", () => {
+  const noRows = createMonthlyReview(encode(empty()), fixed);
+  assert.equal(noRows.summary.currency, "USD");
+  assert.equal(noRows.selectedTransactions, 0);
+  assert.match(noRows.html, /id="empty-categories"/);
+  assert.match(noRows.html, /id="empty-budgets"/);
+  assert.match(noRows.html, /Zero recorded totals do not establish/);
+  const data = empty();
+  data.budgets.push(
+    { category: "Future", month: "2026-04", limitMinor: 600, currency: "USD" },
+    { category: "Zero", month: "2026-04", limitMinor: 0, currency: "USD" },
+  );
+  const report = createMonthlyReview(encode(data), fixed);
+  assert.equal(report.selectedTransactions, 0);
+  assert.deepEqual(report.summary.budgets.map(b => b.remainingMinor), [600, 0]);
+  assert.equal(rowText(report.html, "budget-body").length, 2);
+  assert.match(report.html, /Zero limit; no expenses/);
+});
+
+test("legacy budgets retain an explicit unassigned label in their admitted single-currency context", () => {
+  const data: LedgerData = {
+    version: 1, transactions: [transaction("a", 25, "Legacy")],
+    budgets: [{ category: "Legacy", month: "2026-04", limitMinor: 20 }],
+  };
+  const input = encode(data), report = createMonthlyReview(input, fixed);
+  assert.equal(report.source.ledgerVersion, 1);
+  assert.equal(report.summary.budgets[0].currency, undefined);
+  assert.match(report.html, /Currency unassigned · legacy single-currency context/);
+  assert.equal(report.summary.budgets[0].remainingMinor, -5);
+  assert.deepEqual(input, encode(data), "no currency migration");
+});
+
+test("native ambiguous legacy and unsafe-gross-total refusals remain effective", () => {
+  const legacy: LedgerData = {
+    version: 1, transactions: [transaction("a", 1, "A"), transaction("b", 1, "A", { currency: "EUR" })],
+    budgets: [{ category: "A", month: "2026-04", limitMinor: 10 }],
+  };
+  assert.throws(() => createMonthlyReview(encode(legacy), fixed), /no currency/);
+  legacy.transactions.pop();
+  assert.throws(() => createMonthlyReview(encode(legacy), { ...fixed, currency: "EUR" }), /no currency/);
+  legacy.transactions = [];
+  assert.throws(() => createMonthlyReview(encode(legacy), fixed), /no currency/);
+  const gross = empty();
+  gross.transactions = [transaction("a", Number.MAX_SAFE_INTEGER, "A"), transaction("b", 1, "B")];
+  assert.throws(() => createMonthlyReview(encode(gross), fixed), /safe integer/);
+});
+
+test("special object keys and exact category spellings become ordinary table rows", () => {
+  const data = empty();
+  data.transactions = [
+    transaction("a", 4, "__proto__"), transaction("b", 7, "constructor"), transaction("c", 9, "constructor "),
+  ];
+  data.budgets = [{ category: "__proto__", month: "2026-04", limitMinor: 0, currency: "USD" }];
+  const report = createMonthlyReview(encode(data), fixed);
+  assert.equal(report.summary.byCategory["__proto__"].expenseMinor, 4);
+  assert.equal(report.summary.byCategory["constructor"].expenseMinor, 7);
+  assert.equal(report.summary.byCategory["constructor "].expenseMinor, 9);
+  assert.equal(rowText(report.html, "category-body").length, 3);
+  assert.match(report.html, /<bdi class="label">constructor <\/bdi>/);
+  assert.equal(report.summary.budgets[0].remainingMinor, -4);
+});
+
+test("markup, valid Unicode and HTML newline characters are preserved as inert labels", () => {
+  const category = "</style><script>alert('x')</script><img src=x onerror=x>&\"😀\u2028\u2029\r\n\t";
+  const data = empty();
+  data.transactions = [transaction("a", 11, category)];
+  const report = createMonthlyReview(encode(data), { ...fixed, sourceLabel: "<unsafe>&\".json" });
+  assert.match(report.html, /&lt;\/style&gt;&lt;script&gt;alert\(&#39;x&#39;\)&lt;\/script&gt;/);
+  assert.match(report.html, /😀\u2028\u2029&#13;&#10;&#9;/);
+  assert.match(report.html, /&lt;unsafe&gt;&amp;&quot;\.json/);
+  assert.ok(!report.html.includes("<script"));
+  assert.ok(!report.html.includes("<img"));
+  assert.ok(!report.html.includes("localStorage"));
+  assert.match(report.html, /default-src 'none'/);
+});
+
+test("only unrepresentable displayed labels are refused, without leaking excluded notes or rows", () => {
+  for (const category of ["bad\u0000label", "bad\ud800", "bad\udfff"]) {
+    const data = empty();
+    data.transactions = [transaction("a", 1, category)];
+    assert.throws(() => createMonthlyReview(encode(data), fixed), /NUL|surrogate/);
+    data.transactions[0].currency = "EUR";
+    assert.equal(createMonthlyReview(encode(data), fixed).selectedTransactions, 0);
+    data.transactions[0].category = "Good";
+    data.transactions[0].currency = "USD";
+    data.transactions[0].note = category;
+    assert.equal(createMonthlyReview(encode(data), fixed).selectedTransactions, 1);
+    data.budgets = [{ category, month: "2026-04", limitMinor: 0, currency: "USD" }];
+    assert.throws(() => createMonthlyReview(encode(data), fixed), /NUL|surrogate/);
+  }
+});
+
+test("selection and provenance admit no implicit month, currency, or invalid generated time", () => {
+  const data = encode(empty());
+  for (const currency of ["", " ", "US", "USDD", undefined, null]) {
+    assert.throws(() => createMonthlyReview(data, { ...fixed, currency } as never), /currency/);
+  }
+  for (const month of ["", "2026-4", "2026-00", "2026-13", "1969-12", undefined]) {
+    assert.throws(() => createMonthlyReview(data, { ...fixed, month } as never), /month|year/);
+  }
+  for (const generatedAt of ["today", "2026-02-30T00:00:00.000Z", "2026-10-08T17:00:00Z"]) {
+    assert.throws(() => createMonthlyReview(data, { ...fixed, generatedAt }), /timestamp/);
+  }
+  assert.throws(() => createMonthlyReview(data, { ...fixed, sourceLabel: "" }), /source label/);
+  assert.throws(() => createMonthlyReview(data, { ...fixed, sourceLabel: "x".repeat(181) }), /source label/);
+  assert.throws(() => createMonthlyReview(data, { ...fixed, sourceLabel: "\ud800" }), /surrogate/);
+});
+
+test("strict byte admission refuses invalid UTF-8, BOM, malformed JSON and oversized snapshots", () => {
+  for (const bytes of [Buffer.alloc(0), Buffer.from([0xff]), Buffer.from("{"), Buffer.concat([Buffer.from([0xef, 0xbb, 0xbf]), encode(empty())])]) {
+    assert.throws(() => createMonthlyReview(bytes, fixed), /bytes|UTF-8 JSON/);
+  }
+  assert.throws(() => createMonthlyReview(Buffer.alloc(MAX_REVIEW_INPUT_BYTES + 1), fixed), /bytes/);
+  assert.throws(() => createMonthlyReview(encode({ version: 9, transactions: [], budgets: [] }), fixed), /version/);
+});
+
+test("output escaping expansion refuses the whole oversized report", () => {
+  const data = empty();
+  data.transactions = [transaction("a", 1, "&".repeat(Math.floor(MAX_REVIEW_OUTPUT_BYTES / 5)))];
+  const input = encode(data);
+  assert.ok(input.byteLength < MAX_REVIEW_INPUT_BYTES);
+  assert.throws(() => createMonthlyReview(input, fixed), /complete monthly review exceeds/);
+});
+
+test("safe-integer limits render exactly without decimal or exponent conversion", () => {
+  const data = empty();
