+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { mkdtemp, readFile, writeFile, stat, rm } from "node:fs/promises";
+import { createServer as createNetServer } from "node:net";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+import { CopyClientError, runBudgetCopy, terminalValue } from "../src/budget-copy-client.js";
+
+const request = { fromMonth: "2026-10", toMonth: "2026-11", currency: "USD" };
+const sourceBudgets = [
+  { category: "groceries", month: "2026-10", limitMinor: 12500, currency: "USD" },
+  { category: "旅行\n予定 🧭", month: "2026-10", limitMinor: 7000, currency: "USD" },
+  { category: "zero", month: "2026-10", limitMinor: 0, currency: "USD" },
+  { category: "groceries", month: "2026-10", limitMinor: 90, currency: "EUR" },
+];
+const transaction = { id: "existing-record", type: "expense", amountMinor: 5, currency: "CHF", date: "2026-09-30",
+  category: "unrelated", note: "keep literal", idempotencyKey: "existing:fixture", createdAt: "2026-10-01T00:00:00.000Z" };
+const initial = { version: 2, transactions: [transaction], budgets: [...sourceBudgets,
+  { category: "groceries", month: "2026-11", limitMinor: 12500, currency: "USD" },
+  { category: "groceries", month: "2026-11", limitMinor: 80, currency: "EUR" }] };
+async function snapshot(path: string) {
+  const info = await stat(path, { bigint: true });
+  return { text: await readFile(path, "utf8"), inode: info.ino, mtime: info.mtimeNs };
+}
+async function launch() {
+  const dir = await mkdtemp(join(tmpdir(), "household-copy-client-a0eb-"));
+  const path = join(dir, "fictional-ledger.json");
+  await writeFile(path, JSON.stringify(initial, null, 2) + "\n");
+  const portProbe = createNetServer(); portProbe.listen(0, "127.0.0.1"); await once(portProbe, "listening");
+  const address = portProbe.address(); assert.ok(address && typeof address !== "string");
+  const port = address.port; await new Promise<void>((resolve, reject) => portProbe.close(error => error ? reject(error) : resolve()));
+  const child = spawn(process.execPath, [fileURLToPath(new URL("../src/index.js", import.meta.url))], {
+    env: { ...process.env, HOUSEHOLD_LEDGER_DATA_PATH: path, HOUSEHOLD_LEDGER_HOST: "127.0.0.1", HOUSEHOLD_LEDGER_PORT: String(port) },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  let errors = ""; child.stderr.on("data", chunk => { errors += String(chunk); });
+  const clients: Client[] = [];
+  const origin = "http://127.0.0.1:" + port + "/mcp";
+  const calls: Array<{ name: string; arguments: unknown }> = [];
+  let dropNextCommit = false;
+  const proxy = createServer(async (req, res) => {
+    try {
+      const chunks: Buffer[] = []; for await (const chunk of req) chunks.push(Buffer.from(chunk));
+      const body = Buffer.concat(chunks).toString("utf8");
+      const decoded = body ? JSON.parse(body) as { method?: string; params?: { name?: string; arguments?: unknown } } : {};
+      const name = decoded.method === "tools/call" ? decoded.params?.name : undefined;
+      if (name) calls.push({ name, arguments: decoded.params?.arguments });
+      const headers: Record<string, string> = {};
+      for (const key of ["content-type", "accept", "mcp-protocol-version", "mcp-session-id", "last-event-id"]) {
+        const value = req.headers[key]; if (typeof value === "string") headers[key] = value;
+      }
+      const upstream = await fetch(origin, { method: req.method, headers, ...(body ? { body } : {}), redirect: "error" });
+      const text = await upstream.text();
+      // The unchanged native server has completed its response before this
+      // private transport drops delivery. No product writer/I/O is replaced.
+      if (name === "commit_budget_copy" && dropNextCommit) { dropNextCommit = false; res.destroy(); return; }
+      const responseHeaders: Record<string, string> = {};
+      for (const key of ["content-type", "mcp-session-id"]) {
+        const value = upstream.headers.get(key); if (value) responseHeaders[key] = value;
+      }
+      res.writeHead(upstream.status, responseHeaders); res.end(text);
+    } catch (error) { if (!res.headersSent) res.writeHead(502); res.end(String(error)); }
+  });
+  async function stop() {
+    try {
+      for (const client of clients) await client.close().catch(() => undefined);
+      if (proxy.listening) { proxy.closeAllConnections(); await new Promise<void>(resolve => proxy.close(() => resolve())); }
+    } finally {
+      if (child.exitCode === null && child.signalCode === null) { const ended = once(child, "exit"); child.kill("SIGTERM"); await ended; }
+      await rm(dir, { recursive: true, force: true });
+    }
+    assert.equal(errors, "", "private unchanged server emitted errors");
+  }
+  try {
+    await new Promise<void>((resolve, reject) => {
+      let output = ""; const timer = setTimeout(() => reject(new Error("private server startup timed out")), 20000);
+      child.once("error", e => { clearTimeout(timer); reject(e); });
+      child.once("exit", code => { clearTimeout(timer); reject(new Error("private server exit " + code)); });
+      child.stdout.on("data", chunk => {
+        output += String(chunk); if (output.includes("listening on")) { clearTimeout(timer); resolve(); }
+      });
+    });
+    proxy.listen(0, "127.0.0.1"); await once(proxy, "listening");
+    const proxyAddress = proxy.address(); assert.ok(proxyAddress && typeof proxyAddress !== "string");
+    const endpoint = "http://127.0.0.1:" + proxyAddress.port + "/mcp";
+    async function connect() {
+      const client = new Client({ name: "private-copy-client-receiver", version: "1" }, { capabilities: {} });
+      clients.push(client); await client.connect(new StreamableHTTPClientTransport(new URL(endpoint)));
+      return client;
+    }
+    return { path, endpoint, calls, connect, dropCommitResponse() { dropNextCommit = true; }, stop };
+  } catch (error) { await stop(); throw error; }
+}
+const io = (answer: string | null = "COPY 2026-11 USD") => {
+  const lines: string[] = [];
+  return { lines, async write(text: string) { lines.push(text); }, async confirm() { return answer; } };
+};
+async function tool(client: Client, name: string, args: Record<string, unknown>) {
+  const response = await client.callTool({ name, arguments: args });
+  assert.equal(response.isError, undefined, JSON.stringify(response));
+  const content = response.content as Array<{ type: string; text: string }>;
+  return JSON.parse(content[0].text);
+}
+
+test("real private MCP preview/cancel and explicit copy preserve exact fields; a fresh review of matching targets does not rewrite", async () => {
