+  assert.equal((await runBudgetCopy(g.client, request, g.io)).status, "conflict");
+  assert.equal(g.calls.length, 1); assert.match(g.output.join(""), /999/);
+});
+test("changed selection, incomplete rows/counts, token drift and duplicate identity refuse before confirmation", async () => {
+  const changes: Array<(p: ReturnType<typeof preview>) => void> = [
+    p => { p.toMonth = "2026-12"; },
+    p => { p.rows.pop(); },
+    p => { p.counts.total = 2; },
+    p => { p.reviewToken = "a".repeat(64); },
+    p => { p.review.rows[1].limitMinor = 900; },
+    p => { p.rows[1].category = p.rows[0].category; },
+    p => { p.rows[0].destination[0].limitMinor = 900; },
+  ];
+  for (const change of changes) {
