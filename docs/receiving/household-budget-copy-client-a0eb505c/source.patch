+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { spawnSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { CopyClientError, readCopyPreview, readCopyRequest, runBudgetCopy, terminalValue, type BudgetToolClient } from "../src/budget-copy-client.js";
+import { parseCopyArgs } from "../src/household-budget-copy.js";
+
+const request = { fromMonth: "2026-10", toMonth: "2026-11", currency: "USD" };
+const names = ["groceries", "旅行\n予定 🧭", "zero"];
+function preview() {
+  const limits = [12500, 70, 0];
+  const review = { schema: "household-budget-copy/1", ...request, rows: names.map((category, i) =>
+    ({ category, limitMinor: limits[i], expectedTargetLimitMinor: i === 0 ? limits[i] : null })) };
+  return { schema: review.schema, ...request, canCommit: true, counts: { total: 3, add: 2, alreadyPresent: 1, conflict: 0 },
+    rows: names.map((category, i) => ({ category, limitMinor: limits[i], action: i === 0 ? "already_present" : "add",
+      destination: i === 0 ? [{ category, month: request.toMonth, currency: "USD", limitMinor: limits[i] }] : [] })),
+    review, reviewToken: createHash("sha256").update(JSON.stringify(review)).digest("hex") };
+}
+const reply = (value: unknown) => ({ content: [{ type: "text", text: JSON.stringify(value) }] });
+function receipt(p = preview()) {
+  return { schema: p.schema, ...request, reviewToken: p.reviewToken, added: 2, alreadyPresent: 1,
+    budgets: p.rows.map(row => ({ category: row.category, month: request.toMonth, currency: "USD", limitMinor: row.limitMinor })) };
+}
+function fixture(p: unknown = preview(), result: unknown = receipt()) {
+  const calls: Array<{ name: string; arguments: Record<string, unknown> }> = [];
+  const output: string[] = [];
+  const client: BudgetToolClient = { async callTool(call) {
+    calls.push(structuredClone(call)); return reply(call.name === "preview_budget_copy" ? p : result);
+  }};
+  return { calls, output, client, io: { async write(text: string) { output.push(text); },
+    async confirm() { assert.ok(output.join("").includes("zero")); return "COPY 2026-11 USD"; } } };
+}
+
+test("complete literal review precedes one exact reviewed commit and a checked receipt", async () => {
+  const f = fixture(); const result = await runBudgetCopy(f.client, request, f.io);
+  assert.deepEqual(result, { status: "completed", commitCalls: 1, added: 2, alreadyPresent: 1 });
+  assert.deepEqual(f.calls.map(c => c.name), ["preview_budget_copy", "commit_budget_copy"]);
+  assert.deepEqual(f.calls[1].arguments, { review: preview().review, reviewToken: preview().reviewToken });
+  const output = f.output.join("");
+  for (const value of names) assert.ok(output.includes(terminalValue(value)));
+  assert.ok(output.includes("limitMinor=0")); assert.ok(output.includes("Current destination:"));
+});
+test("cancel, EOF and inexact confirmation never send a commit", async () => {
+  for (const answer of [null, "", "no", "COPY 2026-12 USD", " COPY 2026-11 USD"]) {
+    const f = fixture(); f.io.confirm = async () => answer as string;
+    assert.equal((await runBudgetCopy(f.client, request, f.io)).status, "cancelled");
+    assert.equal(f.calls.length, 1);
+  }
+});
+test("noninteractive preview and conflict output do not ask or commit", async () => {
+  const f = fixture(); f.io.confirm = async () => { throw new Error("must not prompt"); };
+  assert.equal((await runBudgetCopy(f.client, request, f.io, true)).status, "preview_only");
+  assert.equal(f.calls.length, 1);
+  const p = preview(); p.canCommit = false; p.counts = { total: 3, add: 1, alreadyPresent: 1, conflict: 1 };
+  Object.assign(p.rows[1], { action: "conflict", reason: "Different limit", destination: [
+    { category: names[1], month: request.toMonth, currency: "USD", limitMinor: 999 }] });
+  Object.assign(p, { review: null, reviewToken: null });
