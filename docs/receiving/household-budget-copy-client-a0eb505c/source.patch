+    assert.deepEqual(saved.budgets.find((b: { month: string; currency: string }) => b.month === "2026-11" && b.currency === "EUR"), initial.budgets[5]);
+    const complete = await snapshot(service.path);
+    assert.deepEqual(await runBudgetCopy(client, request, io()), { status: "completed", commitCalls: 1, added: 0, alreadyPresent: 3 });
+    assert.deepEqual(await snapshot(service.path), complete);
+    assert.equal(service.calls.filter(c => c.name === "commit_budget_copy").length, 2);
+  } finally { await service.stop(); }
+});
