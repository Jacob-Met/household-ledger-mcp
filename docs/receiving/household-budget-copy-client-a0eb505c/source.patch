+  }
+  assert.throws(() => readCopyPreview(preview(), { ...request, categories: ["zero"] }), /changed or omitted/);
+});
+test("lost, rejected or malformed commit responses remain unconfirmed with no automatic retry", async () => {
+  for (const mode of ["lost", "error", "counts", "target", "missing", "denomination"]) {
+    const f = fixture(); const original = f.client.callTool;
+    f.client.callTool = async call => {
+      if (call.name !== "commit_budget_copy") return original(call);
+      f.calls.push(structuredClone(call));
+      if (mode === "lost") throw new Error("connection lost");
+      if (mode === "error") return { isError: true, content: [{ type: "text", text: "source changed" }] };
+      const r = receipt();
+      if (mode === "counts") r.added = 900;
+      if (mode === "target") r.budgets[1].limitMinor = 900;
+      if (mode === "missing") r.budgets.pop();
+      if (mode === "denomination") r.budgets[1].currency = "UſD";
+      return reply(r);
+    };
+    await assert.rejects(runBudgetCopy(f.client, request, f.io), (e: unknown) =>
+      e instanceof CopyClientError && e.commitAttempted && /not confirmed/.test(e.message));
+    assert.equal(f.calls.length, 2); assert.ok(!f.output.join("").includes("Copy confirmed"));
+  }
+});
+test("failed preview output sends no commit; failed receipt output retains the known server confirmation", async () => {
+  const f = fixture(); f.io.write = async () => { throw new Error("closed output"); };
+  await assert.rejects(runBudgetCopy(f.client, request, f.io), /closed output/); assert.equal(f.calls.length, 1);
