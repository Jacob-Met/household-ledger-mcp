+    const cancelled = io(null);
+    assert.equal((await runBudgetCopy(client, request, cancelled)).status, "cancelled");
+    assert.deepEqual(await snapshot(service.path), before);
+    assert.deepEqual(service.calls.map(c => c.name), ["preview_budget_copy"]);
+    const output = io();
+    const result = await runBudgetCopy(client, request, output);
+    assert.deepEqual(result, { status: "completed", commitCalls: 1, added: 2, alreadyPresent: 1 });
+    for (const row of sourceBudgets.slice(0, 3)) assert.ok(output.lines.join("").includes(terminalValue(row.category)));
+    const saved = JSON.parse((await snapshot(service.path)).text);
+    assert.deepEqual(saved.transactions, [transaction]);
+    assert.deepEqual(saved.budgets.filter((b: { month: string }) => b.month === "2026-10"), sourceBudgets);
+    assert.deepEqual(saved.budgets.filter((b: { month: string; currency: string }) => b.month === "2026-11" && b.currency === "USD"),
