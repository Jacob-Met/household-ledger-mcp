+test("selected unrepresentable text and an explicitly non-string timestamp are refused", () => {
+  const malformed = tx("bad", { createdAt: null as unknown as string });
+  const snapshot = validateLedgerData(data(malformed, tx("healthy", { category: "Other" })));
+  assert.throws(() => exportTransactionsCsv(snapshot), ValidationError);
+  assert.equal(exportTransactionsCsv(snapshot, { category: "Other" }).rowCount, 1);
+  for (const note of ["\ud800", "\udc00", "x\ud800y"]) {
+    assert.throws(() => exportTransactionsCsv(data(tx("bad-note", { note }))), ValidationError);
+  }
+  assert.equal(readStatementCsv(exportTransactionsCsv(data(tx("paired", { note: "😺" }))).csv)[1][6], "😺");
+});
+
+test("new tool arguments reject unsupported keys and wrong shapes without changing existing selectors", () => {
+  const snapshot = data(tx("one"));
+  const before = JSON.stringify(snapshot);
+  for (const filter of [null, [], "", { limit: 1 }, { offset: 0 }, { path: "/tmp/never-write.csv" }, { currency: "USD" }, { query: "food" }, { category: null }, { category: 1 }, { type: null }, { type: "other" }, { from: null }, { from: "2026-02-30" }, { to: "tomorrow" }, { from: 1 }]) {
+    assert.throws(() => exportTransactionsCsv(snapshot, filter), ValidationError);
+  }
+  assert.equal(JSON.stringify(snapshot), before);
+});
