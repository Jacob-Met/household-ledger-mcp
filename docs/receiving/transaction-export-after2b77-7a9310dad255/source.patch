+test("optional or legacy absent values stay empty without inventing a timestamp", () => {
+  const absent = tx("absent");
+  delete (absent as Partial<Transaction>).createdAt;
+  const result = exportTransactionsCsv(validateLedgerData(data(absent, tx("empty", { note: "" }))));
+  assert.deepEqual(readStatementCsv(result.csv).slice(1), [cells(absent), cells(tx("empty", { note: "" }))]);
+});
