+});
+
+test("the inclusive UTF-8 byte boundary includes header and CSV quote expansion", () => {
+  const prefix = HEADER + '"boundary","expense","1","USD","2026-10-01","Food","","","2026-10-01T00:00:00.000Z"\r\n';
+  const room = 1048576 - Buffer.byteLength(prefix);
+  const ascii = "a".repeat(room);
+  const exact = exportTransactionsCsv(data(tx("boundary", { note: ascii })));
+  assert.equal(exact.byteCount, 1048576);
+  assert.equal(readStatementCsv(exact.csv)[1][6], ascii);
+  assert.throws(() => exportTransactionsCsv(data(tx("boundary", { note: ascii + "a" }))), ValidationError);
+  assert.throws(() => exportTransactionsCsv(data(tx("boundary", { note: ascii.slice(1) + '"' }))), ValidationError);
+  const unicode = "é".repeat(Math.floor(room / 2)) + (room % 2 ? "a" : "");
+  assert.equal(exportTransactionsCsv(data(tx("boundary", { note: unicode }))).byteCount, 1048576);
+  assert.throws(() => exportTransactionsCsv(data(tx("boundary", { note: unicode + "😺" }))), ValidationError);
+});
