+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { listTransactions, validateLedgerData, ValidationError, type LedgerData, type Transaction } from "../src/ledger.js";
+import { exportTransactionsCsv } from "../src/transaction-export.js";
+import { readStatementCsv } from "./transaction-export-csv-reader.js";
+
+const COLUMNS = ["id", "type", "amountMinor", "currency", "date", "category", "note", "idempotencyKey", "createdAt"];
+const HEADER = '"id","type","amountMinor","currency","date","category","note","idempotencyKey","createdAt"\r\n';
+const tx = (id: string, changes: Partial<Transaction> = {}): Transaction => ({
+  id, type: "expense", amountMinor: 1, currency: "USD", date: "2026-10-01", category: "Food",
+  createdAt: "2026-10-01T00:00:00.000Z", ...changes,
+});
+const data = (...transactions: Transaction[]): LedgerData => ({
+  version: 2, transactions,
+  budgets: [{ category: "Food", month: "2026-10", currency: "USD", limitMinor: 77 }],
+});
+function cells(row: Transaction): string[] {
+  return COLUMNS.map(key => {
+    const value = row[key as keyof Transaction];
+    return value === undefined ? "" : String(value);
+  });
+}
+function checkMetadata(result: ReturnType<typeof exportTransactionsCsv>, expectedRows: number): void {
+  assert.deepEqual(Object.keys(result).sort(), ["byteCount", "csv", "filename", "format", "mediaType", "rowCount", "sha256"]);
+  assert.equal(result.format, "csv");
+  assert.equal(result.filename, "household-transactions.csv");
+  assert.equal(result.mediaType, "text/csv; charset=utf-8");
+  assert.equal(result.rowCount, expectedRows);
+  assert.equal(result.byteCount, Buffer.byteLength(result.csv, "utf8"));
+  assert.equal(result.sha256, createHash("sha256").update(result.csv, "utf8").digest("hex"));
+  assert.deepEqual(readStatementCsv(result.csv)[0], COLUMNS);
+}
+
+test("statement preserves literal text, quoting, Unicode, formula-like fields and integer minor units", () => {
+  const rows = [
+    tx('one,"雪"', { note: '  café, "quoted"\r\n第二行 😺\nlast\rEND  ', idempotencyKey: 'key:"quoted",€', amountMinor: Number.MAX_SAFE_INTEGER, category: "=SUM(1,2)" }),
+    tx("two", { note: "+1+2", currency: "EUR" }),
+    tx("three", { note: "-9", currency: "JPY" }),
+    tx("four", { note: "@SUM(A1:A2)" }),
+    tx("five", { note: "=1+1" }),
+  ];
+  const snapshot = validateLedgerData(data(...rows));
+  const before = JSON.stringify(snapshot);
+  const result = exportTransactionsCsv(snapshot);
+  checkMetadata(result, rows.length);
+  assert.deepEqual(readStatementCsv(result.csv).slice(1), rows.map(cells));
+  assert.ok(result.csv.includes('"9007199254740991"'));
+  assert.ok(result.csv.startsWith(HEADER));
+  assert.equal(result.csv.startsWith("\uFEFF"), false);
+  assert.equal(JSON.stringify(snapshot), before);
+  assert.deepEqual(exportTransactionsCsv(snapshot), result);
+});
+
+test("selection and tie order are exactly the existing native listing over the same snapshot", () => {
+  const snapshot = data(
+    tx("old", { date: "2026-09-30", category: " Food " }),
+    tx("tie-first", { date: "2026-10-03", currency: "EUR" }),
+    tx("salary", { date: "2026-10-02", type: "income", category: "salary" }),
+    tx("new", { date: "2026-10-04" }),
+    tx("tie-second", { date: "2026-10-03", currency: "JPY" }),
+  );
+  const before = JSON.stringify(snapshot);
+  const filters = [{}, { type: "expense" as const, from: "2026-10-03", to: "2026-10-03" }, { category: " Food " }, { category: "Food" }, { category: "food" }, { category: "" }, { from: "2026-10-05", to: "2026-10-01" }];
+  for (const filter of filters) {
+    const expected = listTransactions(snapshot, { ...filter, limit: 1000 });
+    const result = exportTransactionsCsv(snapshot, filter);
+    checkMetadata(result, expected.total);
