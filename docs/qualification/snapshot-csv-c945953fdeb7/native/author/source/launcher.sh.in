#!/bin/sh
snapshot_csv_install_dir=@APP_DIR@
if [ ! -f "$snapshot_csv_install_dir/INSTALLATION.json" ]; then
  printf '%s\n' '{"error":"Installation is incomplete: INSTALLATION.json is absent"}' >&2
  exit 1
fi
unset NODE_OPTIONS NODE_PATH
exec @NODE@ "$snapshot_csv_install_dir/snapshot-csv.mjs" "$@"
